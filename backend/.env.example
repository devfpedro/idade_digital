# Copie para backend/.env (gitignored) e ajuste. Nunca versione o .env.
# Banco PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=idade_digital
DB_USER=idade_digital
# Deixe DB_PASSWORD em branco: o start.sh/start.bat gera uma senha forte ao criar o banco.
DB_PASSWORD=

# Chave que assina os tokens de login. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Validade do token de login, em horas (a inatividade de 30 min e controlada no frontend)
TOKEN_HORAS=8

# Vozes neurais de leitura (baixadas na primeira execucao, ~60 MB cada):
# A Faber e a voz padrao; cadu e jeff estao em teste. Separe por virgula.
VOZ_PIPER=faber,cadu,jeff
